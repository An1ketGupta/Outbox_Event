{
  "name": "outbox-event-relay",
  "version": "1.0.0",
  "description": "Transactional Outbox Event Relay for reliable event publishing",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker": "tsx watch src/worker/relay.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker/relay.js",
    "test": "NODE_ENV=test jest --runInBand --coverage",
    "test:watch": "NODE_ENV=test jest --watch",
    "test:outbox": "tsx test-outbox.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "lint": "eslint src tests --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "keywords": [
    "outbox",
    "transactional-outbox",
    "event-relay",
    "distributed-systems",
    "redis-streams",
    "prisma",
    "postgresql"
  ],
  "author": "An1ket Gupta <guptaaniket600.ag@gmail.com> (https://github.com/An1ketGupta)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/An1ketGupta/Outbox_Event.git"
  },
  "homepage": "https://github.com/An1ketGupta/Outbox_Event#readme",
  "bugs": {
    "url": "https://github.com/An1ketGupta/Outbox_Event/issues"
  },
  "dependencies": {
    "@prisma/client": "^6.2.0",
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "pg": "^8.13.1",
    "pino": "^10.0.0",
    "pino-http": "^10.3.0",
    "prom-client": "^15.1.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.6",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.18.0",
    "jest": "^29.7.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "prisma": "^6.2.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
