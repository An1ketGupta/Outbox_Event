# DATABASE
DATABASE_URL="postgresql://user:password@localhost:5432/outbox_event_relay?schema=public"

# REDIS
REDIS_URL="redis://localhost:6379"

# SERVER
PORT=3001
NODE_ENV=development

# WORKER
POLL_INTERVAL_MS=1000
BATCH_SIZE=10
MAX_RETRIES=5

# REDIS STREAMS
STREAM_NAME="business-events"

# LOGGING
LOG_LEVEL=info

# CLEANUP
CLEANUP_DAYS=7
